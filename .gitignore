# --- Local dev only ---
.serve.ps1
.tmp/
.DS_Store
Thumbs.db

# Editor / agent state
.vscode/
.claude/

# Source-only folders — the live versions live in /assets and /video_content
brand_logos/
meet_your_new_digital_marketing_partner/

# Raw video originals (the renamed faq-1/2/3.mp4 are what the site references)
video_content/SnapInsta.*

# Heavy gallery source videos — only the compressed /gallery copies are committed
video_content/Videos from notion/

# Encoding helpers (kept local)
.tools/*
!.tools/bump-assets.mjs
!.tools/bump-crm.mjs

# Secrets and OS junk
.env
.env.*
# ...but the template carries no secrets and is the only documentation of
# which variables exist, so it should reach the repo.
!.env.example
!.env.production.example
credentials.json
token.json
*.log
.env
.env.local

# Locally uploaded media (the live site stores this in Supabase)
assets/uploads/

# Pre-repositioning snapshot, kept locally only
_backup/


# Case study films, held out of git on purpose.
# 231MB of video would sit in history permanently. These live on a video host
# instead; content/work.json keeps them under "videosHeld" ready to restore.
assets/work/*.mp4
assets/work/vertical/*.mp4
!assets/work/gifs/*.mp4

# CRM: the local SQLite database. Prospect data never belongs in git.
.data/
.vercel

# Generated prospect lists. Business contact data, and regenerable from the
# source projects, so it has no business in the repo.
prospects-from-directories*.csv

# Sales desk working data. The tooling in tools/sales-desk is code and belongs in
# the repo; what it reads and writes does not.
#   - voice-corpus.json is Earl's own sent email, read out of Outlook
#   - VOICE.md quotes it, and names people outside the business
#   - the rest is prospect contact data, same policy as the directory lists above
tools/sales-desk/voice-corpus.json
tools/sales-desk/VOICE.md
tools/sales-desk/*.csv
tools/sales-desk/sequence.json
tools/sales-desk/prospects.enriched.json
tools/sales-desk/sales-desk.html
