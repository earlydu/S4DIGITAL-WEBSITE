# Copy this to .env.production.local and fill in the two Supabase values.
#
# WHY A SEPARATE FILE: the CRM picks its database purely from whether these two
# variables are set. Put them in .env.local and your local dev server starts
# reading and writing the LIVE prospect database, which you do not want while
# testing. Keeping them here means local dev stays on SQLite, and you only reach
# production when you deliberately pass this file:
#
#   node --env-file=.env.production.local tools/crm.mjs create-user
#   node --env-file=.env.production.local tools/crm.mjs stats
#   node --env-file=.env.production.local tools/crm.mjs import prospects.csv
#
# Both values come from the Supabase dashboard:
#   Project Settings -> API
#     Project URL       -> SUPABASE_URL
#     service_role key  -> SUPABASE_SERVICE_ROLE_KEY   (NOT the anon key)
#
# The service role key bypasses Row Level Security. It is a full-access
# credential. Server side and your own machine only, never in the browser,
# never in git. This file is gitignored.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Must match the value set in Vercel, or the account you create here cannot
# sign in on the live site. Sessions are signed with it.
CRM_SESSION_SECRET=
