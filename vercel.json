{
  "regions": [
    "lhr1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/work/:slug",
      "destination": "/case-study"
    },
    {
      "source": "/blog/:slug",
      "destination": "/post"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    },
    {
      "source": "/sales/:path*",
      "destination": "/sales"
    }
  ],
  "redirects": [
    {
      "source": "/content/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/_backup/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.md)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.py)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.ps1)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.sql)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.csv)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/serve.mjs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.serve.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.env:rest*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pricing",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/services#faq",
      "permanent": true
    },
    {
      "source": "/calculator",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/testimonials",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/crm",
      "destination": "/sales",
      "permanent": true
    },
    {
      "source": "/crm/:path*",
      "destination": "/sales/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/crm",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sales",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/sales/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}