{
  "regions": [
    "lhr1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/blog.mjs": {
      "includeFiles": "{templates/**,404.html,content/**}"
    },
    "api/work.mjs": {
      "includeFiles": "{templates/**,404.html,content/**}"
    },
    "api/pitch.mjs": {
      "includeFiles": "{private/**,404.html}"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/contact",
      "destination": "/"
    },
    {
      "source": "/blog/feed.xml",
      "destination": "/api/blog?feed=1"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/blog?feed=1"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/blog?feed=1"
    },
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    },
    {
      "source": "/work/:slug",
      "destination": "/api/work?slug=:slug"
    },
    {
      "source": "/p/:slug/media/:file",
      "destination": "/api/pitch?slug=:slug&file=:file"
    },
    {
      "source": "/p/:slug",
      "destination": "/api/pitch?slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin"
    },
    {
      "source": "/sales/:path*",
      "destination": "/sales"
    }
  ],
  "redirects": [
    {
      "source": "/content/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.tools/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/templates/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/_backup/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.md)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.py)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.ps1)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.sql)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:file(.*\\.csv)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/serve.mjs",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.serve.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.env:rest*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/post",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[a-z0-9-]+)"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/post",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/case-study",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>[a-z0-9-]+)"
        }
      ],
      "destination": "/work/:slug",
      "permanent": true
    },
    {
      "source": "/case-study",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/blog/:slug(90-day-playbook-ev-scale|consistent-enquiries-every-month|content-plan-ev-installers|ev-installer-website-conversion|ev-lead-follow-up-system|local-seo-for-ev-installers|paid-ads-ev-installers)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/how-to-build-a-scalable-digital-marketing-strategy-for-your-ev-charging-business",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/services#faq",
      "permanent": true
    },
    {
      "source": "/calculator",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/testimonials",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/crm",
      "destination": "/sales",
      "permanent": true
    },
    {
      "source": "/crm/:path*",
      "destination": "/sales/:path*",
      "permanent": true
    },
    {
      "source": "/work/carreducker",
      "destination": "/work/carreducker-shoemakers",
      "permanent": true
    },
    {
      "source": "/work/catherine-marche",
      "destination": "/work/catherine-marche-jeweller",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/api/crm",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/preview/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/p/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/sales",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/sales/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/assets/guide/before-you-film.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Before the camera comes out - s4digital.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
