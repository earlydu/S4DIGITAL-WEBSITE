# Copy to .env.local for local work, and set the same names in Vercel for the live site.
# Never commit real values.

# --- Site admin (/admin) -------------------------------------------------
# The admin fails closed. With no password set, nothing can be edited by anyone.
ADMIN_PASSWORD=choose-something-long
# Optional. Signs the session cookie. Falls back to ADMIN_PASSWORD if unset,
# which means changing the password signs everyone out. Set it to keep them separate.
ADMIN_SECRET=another-long-random-string

# --- Content storage on the live site -----------------------------------
# Without these, the live site can READ content but not save changes, because
# Vercel's filesystem is read only. Locally, saving always works without them.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key-server-side-only
# SUPABASE_BUCKET=s4digital

# --- PlanPulse -----------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Sales CRM (/crm) ----------------------------------------------------
# Signs the CRM session cookie. Without it the CRM refuses to run at all.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It falls back to ADMIN_SECRET then ADMIN_PASSWORD, but give it its own value:
# that way changing the site admin password does not sign you out of the CRM.
CRM_SESSION_SECRET=another-long-random-string

# Only needed to create the FIRST account from the browser at /crm.
# Leave it unset and create the account on the command line instead:
#   node tools/crm.mjs create-user
# Once one account exists the setup screen is closed for good, key or no key.
# CRM_SETUP_KEY=one-time-value-you-can-delete-afterwards

# The CRM stores prospects in Postgres. It reuses SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY from the content section above, so there is nothing
# extra to set. Run the schema once:  node tools/crm.mjs migration
# With no Supabase variables it falls back to local SQLite in .data/crm.db,
# which is fine on your machine and useless on Vercel (nothing survives).

# Optional. "Today" is resolved against this zone, not the server's clock.
# CRM_TIMEZONE=Europe/London

# --- CRM smart features (both cost money, both off until switched on) -----
# Call recording and transcription. Roughly $0.30-0.45 per hour of audio.
# You must tell the other party the call is being recorded.
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1

# Drafting follow-up emails. Roughly a penny an email on Sonnet.
# Reuses ANTHROPIC_API_KEY from the PlanPulse section above.
# CRM_AI_MODEL=claude-sonnet-5

# Neither switches itself on. Turn them on in the CRM under Settings once the
# key is set, so nothing starts billing you the moment a key appears.

# --- CRM password reset --------------------------------------------------
# Without these the "forgotten your password" screen says so plainly, and the
# only way to reset is: node tools/crm.mjs set-password you@example.com
# Resend is used because tuk.co.uk already runs on it, so the account exists.
# RESEND_API_KEY=re_...
# CRM_FROM_EMAIL=s4digital <sales@s4digi.com>   (must be a verified sender)
# CRM_SITE_URL=https://s4digi.com               (only used if the origin is unknown)
